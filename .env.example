DATABASE_URL=sqlite:///./rental_automation.db
TIMEZONE=Asia/Kolkata
TENANT_REGISTRY_MODE=workbook

# Enter these locally in .env. Do not send passwords or one-time codes in chat.
KSEB_WSS_USER_ID=
KSEB_WSS_PASSWORD=
# Optional comma-separated services. Services linked in WSS Billing History are discovered automatically.
KSEB_CONSUMER_NUMBERS=
# Legacy single-service fallback; keep blank to use account discovery.
KSEB_CONSUMER_NUMBER=
KSEB_FETCH_DAY=15

# Optional: set these after deploying the app at a public HTTPS address.
# Manager pages require HTTP Basic authentication; tenant and signer links use bearer tokens.
PUBLIC_APP_URL=
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=

# Generated per installation; required for encrypted ID proof storage in either tenant flow.
ID_PROOF_ENCRYPTION_KEY=
